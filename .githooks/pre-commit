#!/usr/bin/env bash
# Runs on every commit. Fails closed: if a guard can't run, the commit is blocked.
set -e
cd "$(git rev-parse --show-toplevel)"
scripts/check-data-guard.sh
scripts/check-denylist.sh
python3 scripts/check-personal.py
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner --config .gitleaks.toml
else
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
