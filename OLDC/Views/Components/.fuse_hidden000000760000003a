import SwiftUI

struct LiveMetricsGrid: View {
    @ObservedObject var vm: DrCatalystViewModel
    
    // We compute these from the latest "info" or dedicated metrics
    // For now we'll extract them from the issues list or ViewModel state if we added it
    // ideally ViewModel should expose these directly.
    
    var body: some View {
        LazyVGrid(columns: [GridItem(.flexible()), GridItem(.flexible()), GridItem(.flexible())], spacing: 16) {
            // 1. Network
            MetricCard(
                icon: "network",
                gradient: LinearGradient(colors: [.blue, .purple], startPoint: .topLeading, endPoint: .bottomTrailing),
                label: "Network",
                value: "\(activePortsCount) Ports",
                subtext: activePortsCount > 0 ? "Active" : "Quiet"
            )
            
            // 2. Docker
            MetricCard(
                icon: "shippingbox",
                gradient: LinearGradient(colors: [.cyan, .blue], startPoint: .topLeading, endPoint: .bottomTrailing),
                label: "Docker",
                value: isDockerRunning ? "Running" : "Stopped",
                subtext: isDockerRunning ? "\(containerCount) Containers" : "Daemon Off"
            )
            
            // 3. Java
            MetricCard(
                icon: "cup.and.saucer.fill",
                gradient: LinearGradient(colors: [.orange, .red], startPoint: .topLeading, endPoint: .bottomTrailing),
                label: "Java",
                value: javaVersion,
                subtext: "\(jdkCount) JDKs Installed"
            )
            
            // 4. Firewall
            MetricCard(
                icon: "lock.shield",
                gradient: LinearGradient(colors: [.green, .mint], startPoint: .topLeading, endPoint: .bottomTrailing),
                label: "Firewall",
                value: firewallStatus,
                subtext: stealthMode ? "Stealth Mode" : "Standard"
            )
            
            // 5. Architecture
            MetricCard(
                icon: "cpu",
                gradient: LinearGradient(colors: [.indigo, .purple], startPoint: .topLeading, endPoint: .bottomTrailing),
                label: "Silicon",
                value: isRosetta ? "Rosetta" : "Native",
                subtext: isRosetta ? "Performance Hit" : "ARM64 Optimized"
            )
            
            // 6. Identity
            MetricCard(
                icon: "person.crop.circle.badge.checkmark",
                gradient: LinearGradient(colors: [.pink, .orange], startPoint: .topLeading, endPoint: .bottomTrailing),
                label: "Identity",
                value: "Git Config",
                subtext: "Verified"
            )
        }
    }
    
    // Helpers
    var activePortsCount: Int {
        vm.issues.filter { $0.category == .network && $0.title.contains("Port") }.count
    }
    
    var isDockerRunning: Bool {
        !vm.issues.contains { $0.title == "Docker Not Running" }
    }
    
    var containerCount: Int {
         if let issue = vm.issues.first(where: { $0.title.contains("Zombie Containers") }) {
             let digits = issue.title.components(separatedBy: CharacterSet.decimalDigits.inverted).joined()
             return Int(digits) ?? 0
         }
         // If no issue, assume 0 or unknown.
         return 0
    }
    
    var javaVersion: String {
        // If we have an issue "Java Version Chaos", we can infer. 
        // Or if "Java Not Found".
        if vm.issues.contains(where: { $0.title == "Java Not Found" }) { return "Missing" }
        return "Detected" // Placeholder until we plumb real version
    }
    
    var jdkCount: Int {
        if let issue = vm.issues.first(where: { $0.title == "Java Version Chaos" }) {
             // "You have 5 different JDKs..."
             let digits = issue.description.components(separatedBy: CharacterSet.decimalDigits.inverted).joined()
             return Int(digits) ?? 1
        }
        return 1
    }
    
    var firewallStatus: String {
        if vm.issues.contains(where: { $0.title == "Strict Firewall Mode" }) { return "Strict" }
        return "Allowed"
    }
    
    var stealthMode: Bool {
        vm.issues.contains(where: { $0.title == "Stealth Mode Enabled" })
    }
    
    var isRosetta: Bool {
        vm.issues.contains(where: { $0.title == "App Running via Rosetta" })
    }
}

struct MetricCard: View {
    let icon: String
    let gradient: LinearGradient
    let label: String
    let value: String
    let subtext: String
    
    var body: some View {
        VStack(alignment: .leading, spacing: 12) {
            HStack {
                ZStack {
                    Circle()
                        .fill(gradient.opacity(0.1))
                        .frame(width: 38, height: 38)
                    Image(systemName: icon)
                        .foregroundStyle(gradient)
                        .font(.system(size: 18, weight: .semibold))
                }
                Spacer()
            }
            
            VStack(alignment: .leading, spacing: 4) {
                Text(value)
                    .font(.system(.headline, design: .rounded))
                    .fontWeight(.bold)
                    .foregroundColor(.primary)
                
                Text(subtext)
                    .font(.caption2)
                    .foregroundColor(.secondary)
            }
            
            Text(label)
                .font(.caption)
                .fontWeight(.medium)
                .foregroundStyle(gradient)
                .padding(.top, 4)
        }
        .padding(16)
        .background(Material.regular)
        .cornerRadius(16)
        .overlay(
            RoundedRectangle(cornerRadius: 16)
                .stroke(Color.white.opacity(0.1), lineWidth: 1)
        )
    }
}
